{
  "name": "json-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "cd server && go vet ./... && go test ./...",
    "verify": "npm run check && npm run test && npm run build",
    "docker:build": "docker compose build --pull"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@tailwindcss/vite": "^4.1.16",
    "dexie": "^4.2.1",
    "lossless-json": "^4.3.0",
    "svelte-fa": "^4.0.4",
    "svelte-jsoneditor": "^3.10.0",
    "svelte-splitpanes": "^8.0.9",
    "tailwindcss": "^4.1.16"
  }
}
